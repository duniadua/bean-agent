# ==========================================
# Konfigurasi Bean Agent Environment Sample
# Salin file ini menjadi '.env' dan sesuaikan nilainya
# ==========================================

# Kunci API Google Gemini (Dapatkan dari Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Daftar aplikasi yang dipantau/dikelola dalam format JSON String:
# Key   : Nama alias aplikasi yang akan dikenali oleh Bean Agent
# Value : Absolute path direktori aplikasi lokal tempat repository git & docker-compose berada
REGISTERED_APPS='{
  "frontend": "/var/www/apps/frontend-app",
  "backend-api": "/var/www/apps/backend-api",
  "auth-service": "/var/www/apps/auth-service"
}'
